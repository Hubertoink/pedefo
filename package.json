{
  "name": "pedefo",
  "version": "1.0.0",
  "description": "Lightweight lokale PDF-App - Zusammenführen, Aufteilen, Komprimieren",
  "main": "electron-app/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win:x64": "electron-builder --win --x64",
    "build:win:arm64": "electron-builder --win --arm64",
    "build:win:all": "electron-builder --win --x64 --arm64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "pdf",
    "merge",
    "split",
    "compress",
    "electron"
  ],
  "author": "Pedefo",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.pedefo.app",
    "productName": "Pedefo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-app/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "python-dist",
        "to": "python-dist",
        "filter": ["**/*.exe"]
      },
      {
        "from": "electron-app/poppler",
        "to": "poppler"
      }
    ],
    "win": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/PedefO_Icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron-app/assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron-app/assets/icon.png"
    }
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.449"
  }
}
